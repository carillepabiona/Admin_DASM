                </div>
            }
            else
            {
                @foreach (var log in activityLogs)
                {
                    <div class="timeline-item">

                        <div class="timeline-marker @GetTimelineClass(log.Action)">
                        </div>

                        <div class="timeline-content">

                            <div class="activity-header">

                                <span class="activity-icon">
                                    @GetActivityIcon(log.Action)
                                </span>

                                <h4>@log.Action</h4>

                                <span class="timeline-time">
                                    @log.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                </span>

                            </div>

                            <p class="activity-detail">

                                <strong>@log.User</strong>

                                @if (!string.IsNullOrWhiteSpace(log.EntityName))
                                {
                                    <span>
                                        performed action on
                                        <strong>@log.EntityName</strong>
                                    </span>
                                }

                            </p>

                            <p class="activity-description">
                                @log.Description
                            </p>


                        </div>

                    </div>
                }
            }

        </div>

