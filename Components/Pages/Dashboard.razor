<script>
    function switchTab(tabName) {
        // Hide all tab contents
        const contents = document.querySelectorAll('.tab-content');
        contents.forEach(content => content.classList.remove('active'));

        // Remove active class from all buttons
        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach(btn => btn.classList.remove('active'));

        // Show selected tab content
        document.getElementById(tabName).classList.add('active');

        // Add active class to clicked button
        event.target.classList.add('active');
    }
</script>
@code{
    private PeriodicTimer? timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            timer = new PeriodicTimer(
                TimeSpan.FromSeconds(5));

            _ = RefreshLogs();
        }
    }

    private async Task RefreshLogs()
    {
        while (await timer!.WaitForNextTickAsync())
        {
            var result =
                await Http.GetFromJsonAsync<List<ActivityLogModel>>(
                    "api/ActivityLogs");

            if (result != null)
            {
                activityLogs = result;

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // =========================================
    // ACTIVITY LOG MODEL
    // =========================================

    public class ActivityLogModel
    {
        public long Id { get; set; }

        public string User { get; set; } = "";

        public string Action { get; set; } = "";

        public string? EntityName { get; set; }

        public string? EntityId { get; set; }

        public string? Description { get; set; }

        public string? AppType { get; set; }

        public DateTime CreatedAt { get; set; }
    }

    // =========================================
    // DATA
    // =========================================

    private List<ActivityLogModel> activityLogs = new();

    // =========================================
    // LOAD LOGS
    // =========================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result =
                await Http.GetFromJsonAsync<List<ActivityLogModel>>(
                    "api/ActivityLogs");

            if (result != null)
            {
                activityLogs = result;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // =========================================
    // ICON
    // =========================================

    private string GetActivityIcon(string action)
    {
        action = action.ToLower();

        if (action.Contains("upload"))
            return "📤";

        if (action.Contains("download"))
            return "⬇️";

        if (action.Contains("delete"))
            return "🗑️";

        if (action.Contains("login"))
            return "🔐";

        if (action.Contains("view"))
            return "👁️";

        if (action.Contains("rename"))
            return "✏️";

        if (action.Contains("create"))
            return "➕";

        return "📋";
    }

    // =========================================
    // COLOR
    // =========================================

    private string GetTimelineClass(string action)
    {
        action = action.ToLower();

        if (action.Contains("delete"))
            return "error";

        if (action.Contains("login"))
            return "warning";

        if (action.Contains("download"))
            return "info";

        return "success";
    }
}
