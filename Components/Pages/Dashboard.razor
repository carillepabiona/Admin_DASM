@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@using Admin_DASM.Services
@inject CurrentUserService CurrentUserService
<link rel="stylesheet" href="css/dashboard.css">

<div class="dashboard-container">

    <!-- Welcome Section with Background -->
    <div class="welcome-section">
        <div class="welcome-content">
            <div class="welcome-text">
                <h1>
                    Welcome back,
                    @(currentUser?.FullName ?? currentUser?.Username ?? "Admin")! 👋
                </h1>
                <p>Here's what's happening in your system today</p>
            </div>
            <div class="welcome-stat">
                <span class="stat-badge">@dashboard.UploadedToday files uploaded</span>
            </div>
        </div>
    </div>

    <!-- Admin Navigation Tabs -->
    <div class="admin-tabs-wrapper">
        <div class="admin-tabs">
            <button class="tab-btn active" onclick="switchTab('overview')">
                <span class="tab-icon">📊</span>
                <span class="tab-label">Overview</span>
            </button>
            <button class="tab-btn" onclick="switchTab('uploads')">
                <span class="tab-icon">📤</span>
                <span class="tab-label">Today's Uploads</span>
            </button>
            <button class="tab-btn" onclick="switchTab('activity')">
                <span class="tab-icon">📋</span>
                <span class="tab-label">Activity Log</span>
            </button>
        </div>
    </div>

    <!-- TAB 1: OVERVIEW (Dashboard) -->
    <div class="tab-content active" id="overview">

        <!-- Premium Stats Cards with Animations -->
        <div class="stats-grid">
            <div class="stat-card premium">
                <div class="stat-card-header">
                    <div class="stat-icon documents">📊</div>
                    <span class="stat-trend">↑ 12%</span>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Total Documents</p>
                    <p class="stat-value">@dashboard.TotalDocuments</p>
                </div>
                <div class="stat-footer">
                    <span class="stat-period">All time</span>
                </div>
            </div>

            <div class="stat-card premium">
                <div class="stat-card-header">
                    <div class="stat-icon recent">⏱️</div>
                    <span class="stat-trend">↑ 8%</span>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Recently Uploaded</p>
                    <p class="stat-value">@dashboard.RecentlyUploaded</p>
                </div>
                <div class="stat-footer">
                    <span class="stat-period">Last 7 days</span>
                </div>
            </div>

            <div class="stat-card premium">
                <div class="stat-card-header">
                    <div class="stat-icon uploaded">✅</div>
                    <span class="stat-trend highlight">NEW</span>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Uploaded Today</p>
                    <p class="stat-value">@dashboard.UploadedToday</p>
                </div>
                <div class="stat-footer">
                    <span class="stat-period">Today</span>
                </div>
            </div>

            <div class="stat-card premium">
                <div class="stat-card-header">
                    <div class="stat-icon users">👥</div>
                    <span class="stat-trend">↑ 5%</span>
                </div>
                <div class="stat-content">
                    <p class="stat-label">Active Users</p>
                    <p class="stat-value">@dashboard.ActiveUsers</p>
                </div>
                <div class="stat-footer">
                    <span class="stat-period">Online now</span>
                </div>
            </div>
        </div>

        <!-- Overview Bottom Row -->
        <div class="overview-bottom-row">

            <!-- Recent Files Section -->
            <div class="card-section recent-files-card">
                <div class="section-header-card">
                    <h3>📂 Recent Files</h3>
                    <a href="#" class="view-all-link">View All →</a>
                </div>

                <div class="mini-files-list">
                    @foreach (var file in dashboard.RecentFiles)
                    {
                        <div class="mini-file-item">
                            <span class="file-type-badge">
                                @file.FileExtension.Replace(".", "").ToUpper()
                            </span>
                            <div class="mini-file-info">
                                <p class="mini-file-name">@file.OriginalFileName</p>
                                <p class="mini-file-meta">
                                    @(Math.Round(file.FileSize / 1024.0 / 1024.0, 2)) MB • @file.CreatedAt.ToLocalTime().ToString("MMM dd")
                                </p>
                            </div>
                            <div class="file-actions">
                                <button class="file-action-btn">⋮</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            
        </div>
    </div>

    <!-- TAB 2: TODAY'S UPLOADS -->
    <div class="tab-content" id="uploads">
        <div class="section-header-large">
            <div class="section-title-wrapper">
                <h2>📤 Files Uploaded Today</h2>
                <span class="upload-count-badge">@dashboard.TodaysUploads.Count files</span>
            </div>
            <div class="section-actions">
                <input type="text" class="search-input" placeholder="🔍 Search files..." />
                <button class="btn-export">⬇️ Export</button>
            </div>
        </div>

        <div class="today-uploads-grid">
            @foreach (var file in dashboard.TodaysUploads)
            {
                <div class="upload-card premium-card">
                    <div class="upload-card-top">
                        <span class="file-type-badge large">
                            @file.FileExtension.Replace(".", "").ToUpper()
                        </span>
                        <p class="upload-time">@($"{file.CreatedAt.ToLocalTime():hh:mm tt}")</p>
                    </div>

                    <div class="upload-card-content">
                        <h4 class="upload-filename">@file.OriginalFileName</h4>

                        <div class="upload-detail">
                            <span class="detail-label">By:</span>
                            <span class="detail-value">@file.UploadedBy</span>
                        </div>

                        <div class="upload-detail">
                            <span class="detail-label">Size:</span>
                            <span class="detail-value">@(Math.Round(file.FileSize / 1024.0 / 1024.0, 2)) MB</span>
                        </div>
                    </div>

                    <div class="upload-card-footer">
                        <span class="badge-status completed">✓ Completed</span>
                        <div class="upload-card-actions">
                            <button class="card-action-btn" title="Preview">👁️</button>
                            <button class="card-action-btn" title="Download">⬇️</button>
                            <button class="card-action-btn" title="More">⋮</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- TAB 3: ACTIVITY LOG -->
    <div class="tab-content" id="activity">
        <div class="section-header-large">
            <h2>📋 Activity Log & User Actions</h2>
            <div class="filter-controls">
                <select class="filter-select">
                    <option>All Activities</option>
                    <option>Upload</option>
                    <option>Download</option>
                    <option>Delete</option>
                    <option>Login</option>
                </select>
            </div>
        </div>

        <div class="activity-timeline-container">
            @if (activityLogs.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p class="empty-title">No activity yet</p>
                    <p class="empty-text">When users perform actions, they will appear here</p>
                </div>
            }
            else
            {
                <div class="activity-timeline">
                    @foreach (var log in activityLogs)
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker @GetTimelineClass(log.Action)">
                                <span class="marker-icon">@GetActivityIcon(log.Action)</span>
                            </div>

                            <div class="timeline-content">
                                <div class="activity-header">
                                    <h4>@log.Action</h4>
                                    <span class="activity-timestamp">
                                        @log.CreatedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")
                                    </span>
                                </div>

                                <p class="activity-user">
                                    <strong>@log.User</strong>
                                    @if (!string.IsNullOrWhiteSpace(log.EntityName))
                                    {
                                        <span>on <strong>@log.EntityName</strong></span>
                                    }
                                </p>

                                @if (!string.IsNullOrWhiteSpace(log.Description))
                                {
                                    <p class="activity-description">@log.Description</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>

<script>
    function switchTab(tabName) {
        // Hide all tab contents
        const contents = document.querySelectorAll('.tab-content');
        contents.forEach(content => content.classList.remove('active'));

        // Remove active class from all buttons
        const buttons = document.querySelectorAll('.tab-btn');
        buttons.forEach(btn => btn.classList.remove('active'));

        // Show selected tab content
        document.getElementById(tabName).classList.add('active');

        // Add active class to clicked button
        event.target.closest('.tab-btn').classList.add('active');
    }
</script>

@code {
    private PeriodicTimer? timer;

    private DashboardData dashboard = new();

    private UserSession? currentUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            timer = new PeriodicTimer(
                TimeSpan.FromSeconds(5));

            _ = RefreshLogs();
        }
    }

    private async Task RefreshLogs()
    {
        while (await timer!.WaitForNextTickAsync())
        {
            var result =
                await Http.GetFromJsonAsync<List<ActivityLogModel>>(
                    "api/ActivityLogs");

            if (result != null)
            {
                activityLogs = result;

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    // =========================================
    // ACTIVITY LOG MODEL
    // =========================================

    public class ActivityLogModel
    {
        public long Id { get; set; }

        public string User { get; set; } = "";

        public string Action { get; set; } = "";

        public string? EntityName { get; set; }

        public string? EntityId { get; set; }

        public string? Description { get; set; }

        public string? AppType { get; set; }

        public DateTime CreatedAt { get; set; }
    }

    // =========================================
    // DATA
    // =========================================

    private List<ActivityLogModel> activityLogs = new();

    // =========================================
    // LOAD LOGS
    // =========================================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // =====================================
            // GET CURRENT USER
            // =====================================

            currentUser =
                await CurrentUserService.GetUser();

            // =====================================
            // LOAD ACTIVITY LOGS
            // =====================================

            var logs =
                await Http.GetFromJsonAsync<List<ActivityLogModel>>(
                    "api/ActivityLogs");

            if (logs != null)
            {
                activityLogs = logs;
            }

            // =====================================
            // LOAD DASHBOARD DATA
            // =====================================

            var dashboardResult =
                await Http.GetFromJsonAsync<DashboardData>(
                    "api/Dashboard");

            if (dashboardResult != null)
            {
                dashboard = dashboardResult;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    // =========================================
    // ICON
    // =========================================

    private string GetActivityIcon(string action)
    {
        action = action.ToLower();

        if (action.Contains("upload"))
            return "📤";

        if (action.Contains("download"))
            return "⬇️";

        if (action.Contains("delete"))
            return "🗑️";

        if (action.Contains("login"))
            return "🔐";

        if (action.Contains("view"))
            return "👁️";

        if (action.Contains("rename"))
            return "✏️";

        if (action.Contains("create"))
            return "➕";

        return "📋";
    }

    // =========================================
    // COLOR
    // =========================================

    private string GetTimelineClass(string action)
    {
        action = action.ToLower();

        if (action.Contains("delete"))
            return "error";

        if (action.Contains("login"))
            return "warning";

        if (action.Contains("download"))
            return "info";

        return "success";
    }


    // =========================================
    // DASHBOARD DATA
    // =========================================

  
    public class DashboardData
    {
        public int TotalDocuments { get; set; }

        public int RecentlyUploaded { get; set; }

        public int UploadedToday { get; set; }

        public int ActiveUsers { get; set; }

        public List<DocumentItem> RecentFiles { get; set; } = new();

        public List<DocumentItem> TodaysUploads { get; set; } = new();
    }

    public class DocumentItem
    {
        public Guid Id { get; set; }

        public string OriginalFileName { get; set; } = "";

        public string FileExtension { get; set; } = "";

        public long FileSize { get; set; }

        public DateTime CreatedAt { get; set; }

        public string UploadedBy { get; set; } = "";
    }
}
