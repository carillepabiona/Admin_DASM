@page "/create-user"

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using Admin_DASM.Services
@inject HttpClient Http
@inject CurrentUserService CurrentUserService

<head>
    <link rel="stylesheet" href="css/create-user.css" />
</head>

<div class="create-user-container">

    <div class="page-header">
        <h1>Create New User</h1>

        <p class="subtitle">
            Add a new user to the system
        </p>

        <!-- CURRENT SESSION USER -->
        <div class="current-user-session">

            Logged in as:

            <strong>
                @currentUserFullName
            </strong>

        </div>

    </div>

    <!-- SUCCESS MODAL POPUP -->
    @if (!string.IsNullOrWhiteSpace(successMessage) && showSuccessModal)
    {
        <div class="modal-overlay" @onclick="CloseSuccessModal">
            <div class="modal-popup modal-success" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-icon success-icon">✓</div>
                </div>
                <div class="modal-body">
                    <h2 class="modal-title">Success!</h2>
                    <p class="modal-message">@successMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-modal" @onclick="CloseSuccessModal">OK</button>
                </div>
            </div>
        </div>
    }

    <!-- ERROR MODAL POPUP -->
    @if (!string.IsNullOrWhiteSpace(errorMessage) && showErrorModal)
    {
        <div class="modal-overlay" @onclick="CloseErrorModal">
            <div class="modal-popup modal-error" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <div class="modal-icon error-icon">!</div>
                </div>
                <div class="modal-body">
                    <h2 class="modal-title">Error!</h2>
                    <p class="modal-message">@errorMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-modal" @onclick="CloseErrorModal">Close</button>
                </div>
            </div>
        </div>
    }

    <EditForm Model="@userModel"
              OnValidSubmit="@HandleSubmit">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <!-- USER INFORMATION -->
        <div class="form-section">

            <h2 class="section-title">
                User Information
            </h2>

            <div class="form-row">

                <div class="form-group">

                    <label>USER CODE</label>

                    <InputText @bind-Value="userModel.UserCode"
                               readonly
                               class="form-control" />

                </div>

                <div class="form-group">

                    <label>FULL NAME</label>

                    <InputText @bind-Value="userModel.FullName"
                               class="form-control" />

                    <ValidationMessage For="@(() => userModel.FullName)" />

                </div>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label>USERNAME</label>

                    <InputText @bind-Value="userModel.Username"
                               class="form-control" />

                    <ValidationMessage For="@(() => userModel.Username)" />

                </div>

                <div class="form-group">

                    <label>EMAIL</label>

                    <InputText type="email"
                               @bind-Value="userModel.Email"
                               class="form-control" />

                    <ValidationMessage For="@(() => userModel.Email)" />

                </div>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label>PASSWORD</label>

                    <InputText type="password"
                               @bind-Value="userModel.Password"
                               class="form-control" />

                    <ValidationMessage For="@(() => userModel.Password)" />

                </div>

                <div class="form-group">

                    <label>CONTACT NUMBER</label>

                    <InputText @bind-Value="userModel.ContactNumber"
                               class="form-control" />

                    <ValidationMessage For="@(() => userModel.ContactNumber)" />

                </div>

            </div>

            <div class="form-row">

                <div class="form-group full-width">

                    <label>ADDRESS</label>

                    <InputText @bind-Value="userModel.Address"
                               class="form-control" />

                </div>

            </div>

        </div>

        <!-- ACCESS CONTROL -->
        <div class="form-section">

            <h2 class="section-title">
                Access Control
            </h2>

            <div class="form-row">

                <!-- ACCESS LEVEL -->
                <div class="form-group">

                    <label>ACCESS LEVEL</label>

                    <InputSelect @bind-Value="userModel.AccessLevelId"
                                 class="form-control">

                        <option value="0">
                            Select Access Level
                        </option>

                        @if (accessLevels != null && accessLevels.Any())
                        {
                            @foreach (var access in accessLevels)
                            {
                                <option value="@access.Id">
                                    @access.Name
                                </option>
                            }
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => userModel.AccessLevelId)" />

                </div>

                <!-- ROLE -->
                <div class="form-group">

                    <label>ROLE</label>

                    <InputSelect @bind-Value="userModel.RoleId"
                                 class="form-control">

                        <option value="0">
                            Select Role
                        </option>

                        @if (roles != null && roles.Any())
                        {
                            @foreach (var role in roles)
                            {
                                <option value="@role.Id">
                                    @role.Name
                                </option>
                            }
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => userModel.RoleId)" />

                </div>

            </div>

            <div class="form-group checkbox-group">

                <InputCheckbox @bind-Value="userModel.IsActive" />

                <label>Active</label>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@isLoading">

                    @if (isLoading)
                    {
                        <span>CREATING...</span>
                    }
                    else
                    {
                        <span>CREATE USER</span>
                    }

                </button>

                <button type="button"
                        class="btn btn-secondary"
                        @onclick="ClearForm">

                    CLEAR

                </button>

            </div>

        </div>

    </EditForm>

</div>

@code {

    private UserModel userModel = new();

    private List<RoleDto> roles = new();

    private List<AccessLevelDto> accessLevels = new();

    private string successMessage = "";

    private string errorMessage = "";

    private bool isLoading = false;

    private bool showSuccessModal = false;

    private bool showErrorModal = false;

    // =========================================
    // CURRENT USER SESSION
    // =========================================

    private Guid currentUserId;

    private string currentUserFullName = "";

    protected override async Task OnInitializedAsync()
    {
        userModel.UserCode = GenerateUserCode();

        userModel.IsActive = true;

        // GET CURRENT LOGGED IN USER
        var currentUser =
            await CurrentUserService.GetUser();

        if (currentUser != null)
        {
            currentUserId = currentUser.Id;

            currentUserFullName = currentUser.FullName;
        }

        await LoadRoles();

        await LoadAccessLevels();
    }

    // =========================
    // LOAD ROLES
    // =========================

    private async Task LoadRoles()
    {
        try
        {
            var response = await Http.GetAsync(
                "api/roles");

            if (!response.IsSuccessStatusCode)
            {
                ShowError($"Failed to load roles. Status: {response.StatusCode}");
                return;
            }

            roles =
                await response.Content
                    .ReadFromJsonAsync<List<RoleDto>>()
                ?? new();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load roles: {ex.Message}");
        }
    }

    // =========================
    // LOAD ACCESS LEVELS
    // =========================

    private async Task LoadAccessLevels()
    {
        try
        {
            var response = await Http.GetAsync(
                "api/accesslevels");

            if (!response.IsSuccessStatusCode)
            {
                ShowError($"Failed to load access levels. Status: {response.StatusCode}");
                return;
            }

            accessLevels =
                await response.Content
                    .ReadFromJsonAsync<List<AccessLevelDto>>()
                ?? new();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load access levels: {ex.Message}");
        }
    }

    // =========================
    // GENERATE USER CODE
    // =========================

    private string GenerateUserCode()
    {
        return $"USR-{DateTime.Now:yyyyMMddHHmmss}";
    }

    // =========================
    // SUBMIT
    // =========================

    private async Task HandleSubmit()
    {
        successMessage = "";
        errorMessage = "";
        showSuccessModal = false;
        showErrorModal = false;

        if (!IsPasswordStrong(userModel.Password))
        {
            ShowError("Password must contain uppercase, lowercase, and special character.");
            return;
        }

        try
        {
            isLoading = true;

            // =========================================
            // SAVE CURRENT SESSION USER
            // =========================================

            userModel.CreatedBy = currentUserId;

            userModel.CreatedByName = currentUserFullName;

            userModel.CreatedAt = DateTime.Now;

            var response = await Http.PostAsJsonAsync(
                "api/users",
                userModel);

            if (response.IsSuccessStatusCode)
            {
                ShowSuccess($"User created successfully by {currentUserFullName}.");
                await Task.Delay(2000); // Let user read the message
                ClearForm();
            }
            else
            {
                ShowError(await response.Content.ReadAsStringAsync());
            }
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // =========================
    // MODAL HELPERS
    // =========================

    private void ShowSuccess(string message)
    {
        successMessage = message;
        showSuccessModal = true;
    }

    private void ShowError(string message)
    {
        errorMessage = message;
        showErrorModal = true;
    }

    private void CloseSuccessModal()
    {
        showSuccessModal = false;
        successMessage = "";
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        errorMessage = "";
    }

    // =========================
    // PASSWORD VALIDATION
    // =========================

    private bool IsPasswordStrong(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            return false;

        if (password.Length < 8)
            return false;

        bool hasUpperCase =
            Regex.IsMatch(password, "[A-Z]");

        bool hasLowerCase =
            Regex.IsMatch(password, "[a-z]");

        bool hasSpecialChar =
            Regex.IsMatch(
                password,
                "[!@#$%^&*()_+\\-=\\[\\]{};':\"\\\\|,.<>\\/?]");

        return hasUpperCase &&
               hasLowerCase &&
               hasSpecialChar;
    }

    // =========================
    // CLEAR FORM
    // =========================

    private void ClearForm()
    {
        userModel = new UserModel
        {
            UserCode = GenerateUserCode(),
            IsActive = true
        };

        successMessage = "";
        errorMessage = "";
        showSuccessModal = false;
        showErrorModal = false;
    }

    // =========================
    // USER MODEL
    // =========================

    public class UserModel
    {
        public string UserCode { get; set; }

        [Required]
        public string FullName { get; set; }

        [Required]
        public string Username { get; set; }

        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        public string Password { get; set; }

        [Required]
        public string ContactNumber { get; set; }

        public string Address { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Select role")]
        public int RoleId { get; set; }

        [Range(1, int.MaxValue, ErrorMessage = "Select access level")]
        public int AccessLevelId { get; set; }

        public bool IsActive { get; set; } = true;

        // =========================================
        // CREATED BY SESSION USER
        // =========================================

        public Guid CreatedBy { get; set; }

        public string CreatedByName { get; set; }

        public DateTime CreatedAt { get; set; }
    }

    // =========================
    // ROLE DTO
    // =========================

    public class RoleDto
    {
        public int Id { get; set; }

        public string Name { get; set; }
    }

    // =========================
    // ACCESS LEVEL DTO
    // =========================

    public class AccessLevelDto
    {
        public int Id { get; set; }

        public string Name { get; set; }
    }
}
