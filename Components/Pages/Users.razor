@page "/users"
@using System.Net.Http.Json
@using System.Collections.Generic


<head>
    <link rel="stylesheet" href="css/users.css" />
</head>

<div class="users-container">
    <!-- Page Header -->
    <div class="page-header">
        <h1>Users Management</h1>
        <p>View and manage system users</p>
    </div>

    <!-- Filters & Search Section -->
    <div class="filters-section">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" placeholder="Search by name, email, ID..."
                   @oninput="@((ChangeEventArgs e) => SearchUsers(e.Value?.ToString()))">
        </div>

        <div class="filter-controls">
            <select class="filter-dropdown"
                    @onchange="@((ChangeEventArgs e) => FilterByRole(e.Value?.ToString()))">
                <option value="">All Roles</option>
                <option value="Admin">Admin</option>
                <option value="Civilian">Civilian</option>
                <option value="Military Personnel">Military Personnel</option>
            </select>

            <select class="filter-dropdown"
                    @onchange="@((ChangeEventArgs e) => FilterByStatus(e.Value?.ToString()))">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>

            <div class="view-toggle">
                <button class="view-btn @(viewMode == "card" ? "active" : "")"
                        @onclick="@(() => SetViewMode("card"))">
                    <i class="fas fa-th"></i> Card
                </button>

                <button class="view-btn @(viewMode == "table" ? "active" : "")"
                        @onclick="@(() => SetViewMode("table"))">
                    <i class="fas fa-table"></i> Table
                </button>

                <button class="view-btn @(viewMode == "list" ? "active" : "")"
                        @onclick="@(() => SetViewMode("list"))">
                    <i class="fas fa-list"></i> List
                </button>
            </div>
        </div>
    </div>

    <!-- Showing Count -->
    <div class="results-info">
        Showing @filteredUsers.Count of @users.Count users
    </div>

    <!-- Loading -->
    @if (isLoading)
    {
        <div class="loading-container">
            <p>Loading users...</p>
        </div>
    }

    <!-- Users Grid (Card View) -->
    @if (!isLoading && viewMode == "card")
    {
        <div class="users-grid">
            @foreach (var user in filteredUsers)
            {
                <div class="user-card">

                    <!-- Avatar & Status -->
                    <div class="card-header">
                        <div class="avatar" style="background-color: @user.AvatarColor">
                            @user.Avatar
                        </div>

                        <span class="status-badge"
                              style="background-color: @(user.IsActive ? "#d4f4dd" : "#ffe0e0")">
                            @(user.IsActive ? "ACTIVE" : "INACTIVE")
                        </span>
                    </div>

                    <!-- User Info -->
                    <div class="card-body">
                        <h3>@user.Username</h3>

                        <div class="user-details">

                            <div class="detail-row">
                                <i class="fas fa-id-card"></i>
                                <span>ID: @user.UserId</span>
                            </div>

                            <div class="detail-row">
                                <i class="fas fa-envelope"></i>
                                <span>@user.Email</span>
                            </div>

                            <div class="detail-row">
                                <i class="fas fa-phone"></i>
                                <span>@user.Phone</span>
                            </div>

                            <div class="detail-row">
                                <i class="fas fa-user-tag"></i>
                                <span>@user.Role</span>
                            </div>

                            <div class="detail-row">
                                <i class="fas fa-shield-alt"></i>
                                <span>@user.Level</span>
                            </div>

                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card-footer">
                        <button class="action-btn view-btn" title="View">
                            <i class="fas fa-eye"></i>
                        </button>

                        <button class="action-btn edit-btn" title="Edit">
                            <i class="fas fa-edit"></i>
                        </button>

                        <button class="action-btn download-btn" title="Download">
                            <i class="fas fa-download"></i>
                        </button>

                        <button class="action-btn share-btn" title="Share">
                            <i class="fas fa-share-alt"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Table View -->
    @if (!isLoading && viewMode == "table")
    {
        <div class="table-container">
            <table class="users-table">

                <thead>
                    <tr>
                        <th>Avatar</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Level</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in filteredUsers)
                    {
                        <tr>

                            <td>
                                <div class="avatar"
                                     style="background-color: @user.AvatarColor; width: 35px; height: 35px; margin: 0;">
                                    @user.Avatar
                                </div>
                            </td>

                            <td>@user.Username</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>@user.Role</td>
                            <td>@user.Level</td>

                            <td>
                                <span class="status-badge"
                                      style="background-color: @(user.IsActive ? "#d4f4dd" : "#ffe0e0")">
                                    @(user.IsActive ? "ACTIVE" : "INACTIVE")
                                </span>
                            </td>

                            <td>
                                <div class="action-buttons">

                                    <button class="action-btn view-btn" title="View">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    <button class="action-btn edit-btn" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </button>

                                    <button class="action-btn download-btn" title="Download">
                                        <i class="fas fa-download"></i>
                                    </button>

                                    <button class="action-btn share-btn" title="Share">
                                        <i class="fas fa-share-alt"></i>
                                    </button>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <!-- List View -->
    @if (!isLoading && viewMode == "list")
    {
        <div class="list-container">

            @foreach (var user in filteredUsers)
            {
                <div class="list-item">

                    <div class="list-item-left">
                        <div class="avatar" style="background-color: @user.AvatarColor">
                            @user.Avatar
                        </div>

                        <div class="list-item-info">
                            <h4>@user.Username</h4>
                            <p>@user.Email</p>
                        </div>
                    </div>

                    <div class="list-item-middle">

                        <span class="role-badge">
                            @user.Role
                        </span>

                        <span class="status-badge"
                              style="background-color: @(user.IsActive ? "#d4f4dd" : "#ffe0e0")">
                            @(user.IsActive ? "ACTIVE" : "INACTIVE")
                        </span>

                    </div>

                    <div class="list-item-actions">

                        <button class="action-btn view-btn">
                            <i class="fas fa-eye"></i>
                        </button>

                        <button class="action-btn edit-btn">
                            <i class="fas fa-edit"></i>
                        </button>

                        <button class="action-btn download-btn">
                            <i class="fas fa-download"></i>
                        </button>

                        <button class="action-btn share-btn">
                            <i class="fas fa-share-alt"></i>
                        </button>

                    </div>
                </div>
            }

        </div>
    }
</div>

@code {

    [Inject] HttpClient Http { get; set; }

    private List<UserModel> users = new();
    private List<UserModel> filteredUsers = new();

    private string viewMode = "card";
    private string searchTerm = "";
    private string selectedRole = "";
    private string selectedStatus = "";

    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            isLoading = true;

            // YOUR API URL
            var apiUsers = await Http.GetFromJsonAsync<List<ApiUserResponse>>(
                "http://192.168.11.10:5043/api/users");

            if (apiUsers != null)
            {
                users = apiUsers.Select(user => new UserModel
                {
                    Avatar = GetAvatar(user.Username),

                    AvatarColor = GetAvatarColor(
                        user.Role?.Name
                    ),

                    Username = user.Username,

                    UserId = user.UserCode,

                    Email = user.Email,

                    Phone = user.ContactNumber,
                   

                    Role = user.Role?.Name ?? "Unknown",

                    Level = user.AccessLevel?.Name ?? "No Level",

                    IsActive = user.IsActive

                }).ToList();

                filteredUsers = users;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetAvatar(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
            return "U";

        return username.Substring(0, 1).ToUpper();
    }

    private string GetAvatarColor(string role)
    {
        return role switch
        {
            "Admin" => "#8b7dc8",
            "Civilian" => "#7b9bc8",
            "Military Personnel" => "#5f8dd3",
            _ => "#7b9bc8"
        };
    }

    private void SearchUsers(string term)
    {
        searchTerm = term?.ToLower() ?? "";
        ApplyFilters();
    }

    private void FilterByRole(string role)
    {
        selectedRole = role ?? "";
        ApplyFilters();
    }

    private void FilterByStatus(string status)
    {
        selectedStatus = status ?? "";
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        filteredUsers = users.Where(u =>
        {
            var matchesSearch =
                string.IsNullOrEmpty(searchTerm) ||
                u.Username.ToLower().Contains(searchTerm) ||
                u.Email.ToLower().Contains(searchTerm) ||
                u.UserId.ToLower().Contains(searchTerm);

            var matchesRole =
                string.IsNullOrEmpty(selectedRole) ||
                u.Role == selectedRole;

            var matchesStatus =
                string.IsNullOrEmpty(selectedStatus) ||
                (selectedStatus == "Active" && u.IsActive) ||
                (selectedStatus == "Inactive" && !u.IsActive);

            return matchesSearch &&
                   matchesRole &&
                   matchesStatus;

        }).ToList();
    }

    private void SetViewMode(string mode)
    {
        viewMode = mode;
    }

    // =========================
    // UI MODEL
    // =========================

    public class UserModel
    {
        public string Avatar { get; set; }
        public string AvatarColor { get; set; }
        public string Username { get; set; }
        public string UserId { get; set; }
        public string Email { get; set; }
        public string Phone { get; set; }
        public string Role { get; set; }
        public string Level { get; set; }
        public bool IsActive { get; set; }
    }

    // =========================
    // API RESPONSE MODEL
    // =========================

    public class ApiUserResponse
    {
        public Guid Id { get; set; }

        public string UserCode { get; set; }

        public string FullName { get; set; }

        public string Username { get; set; }

        public string Email { get; set; }

        public string ContactNumber { get; set; }

        public bool IsActive { get; set; }

        public RoleResponse Role { get; set; }

        public AccessLevelResponse AccessLevel { get; set; }
    }

    public class RoleResponse
    {
        public int Id { get; set; }

        public string Name { get; set; }
    }

    public class AccessLevelResponse
    {
        public int Id { get; set; }

        public string Name { get; set; }

        public bool CanView { get; set; }

        public bool CanEdit { get; set; }

        public bool CanShare { get; set; }

        public bool CanDownload { get; set; }

        public bool CanDelete { get; set; }
    }
}